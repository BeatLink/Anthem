{
  "name": "anthem",
  "version": "0.1.0",
  "description": "A customizable music player with a real library engine",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && svelte-check --tsconfig tsconfig.web.json",
    "theme": "node scripts/build-theme.mjs",
    "postinstall": "electron-rebuild -f -w better-sqlite3 || echo 'electron-rebuild skipped; run npm run rebuild:electron before npm run dev'",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "bench": "vitest bench --run",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3",
    "check": "npm run typecheck && npm run test"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tsconfig/node22": "^22.0.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "@vitest/coverage-v8": "^4.1.11",
    "electron": "^43.0.0",
    "electron-vite": "^5.0.0",
    "fast-check": "^3.23.2",
    "svelte": "^5.56.10",
    "svelte-check": "^4.1.1",
    "typescript": "^5.7.2",
    "vite": "^7.0.0",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
