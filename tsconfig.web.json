{
  "extends": "@tsconfig/node22/tsconfig.json",
  "include": ["src/renderer/**/*", "src/renderer/**/*.svelte", "src/preload/*.d.ts", "src/shared/**/*"],
  "compilerOptions": {
    "composite": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "baseUrl": ".",
    "paths": { "@renderer/*": ["src/renderer/*"], "@shared/*": ["src/shared/*"] }
  }
}
