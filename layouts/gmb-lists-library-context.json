{
  "id": "gmb-lists-library-context",
  "name": "Lists, Library & Context",
  "note": "Structure mirrors gmusicbrowser's default layout of the same name; see DESIGN-SPEC §5.",
  "window": { "min": [900, 560], "default": [1400, 900] },
  "root": {
    "type": "split", "dir": "vertical", "sizes": ["auto", 1, "auto"],
    "children": [
      { "type": "toolbar", "id": "hbmenu",
        "props": { "items": ["mainmenu", "layoutmenu", "spacer", "safety", "theme"] } },
      { "type": "split", "dir": "horizontal", "sizes": ["420px", 1],
        "children": [
          { "type": "split", "dir": "vertical", "sizes": ["auto", 1],
            "children": [
              { "type": "playerblock", "id": "vbplayer" },
              { "type": "tabbedlists", "id": "lists",
                "props": { "pages": ["playlist", "queue", "songinfo", "pictures"] } }
            ]},
          { "type": "tabs", "id": "tbright",
            "props": { "pages": [
              { "id": "library", "label": "Library", "node": {
                  "type": "split", "dir": "vertical", "sizes": ["190px", 1],
                  "children": [
                    { "type": "filterpanes", "id": "hpfp",
                      "props": { "panes": [
                        { "field": "genre" }, { "field": "album_artist" }, { "field": "album" }
                      ]}},
                    { "type": "songlist", "id": "main", "props": {
                        "search": true,
                        "columns": ["track_number", "title", "artist", "album", "year",
                                    "length", "rating", "play_count"],
                        "sort": [{ "field": "album" }, { "field": "disc_number" },
                                 { "field": "track_number" }]
                    }}
                  ]}},
              { "id": "context", "label": "Context", "node": { "type": "contextpanel" } }
            ]}}
        ]},
      { "type": "statusbar", "id": "status" }
    ]
  }
}
